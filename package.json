{
  "name": "mutav-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "@types/node": "^20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"web,pay,adm,cvx\" --prefix-colors \"cyan,green,yellow,magenta\" --kill-others-on-fail \"bun run dev:web\" \"bun run dev:pay\" \"bun run dev:admin\" \"bun run dev:convex\"",
    "dev:web": "bun --filter @mutav/agency dev",
    "dev:pay": "bun --filter @mutav/pay dev",
    "dev:admin": "bun --filter @mutav/admin dev",
    "dev:convex": "convex dev",
    "convex:env:sync": "bash scripts/sync-convex-env.sh",
    "seed": "convex run seed:seedReset",
    "build": "turbo run build",
    "start": "bun --filter @mutav/agency start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "bun --filter @mutav/agency test:watch",
    "test:convex": "vitest run convex/",
    "test:convex:watch": "vitest convex/",
    "test:structure": "tsc -p tests --noEmit && vitest run tests/",
    "test:file": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog:draft": "bun run scripts/changelog/draft.ts",
    "changelog:validate": "bun run scripts/changelog/validate.ts --lint-pending",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.20.0",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/migrations": "^0.3.5",
    "@creit.tech/stellar-wallets-kit": "^2.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@tanstack/react-table": "^8.21.3",
    "canonicalize": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "convex-helpers": "^0.1.118",
    "lucide-react": "^1.8.0",
    "next": "16.2.9",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "recharts": "3.8.0",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/expect": "^4.1.6",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.53",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "turbo": "2.9.16",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
