#!/bin/sh
#
# Runs typecheck + lint before a commit lands. Skips when no JS/TS files
# are staged (so commits that touch only docs/markdown stay fast).
#
# Setup (run once after cloning):
#   git config core.hooksPath .githooks
#
# To bypass in an emergency (NOT recommended):
#   git commit --no-verify

set -e

# Only fire when JS/TS source is touched. Touching just markdown/json
# shouldn't pay the typecheck cost.
staged=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

# Resolve the package runner. Bun is the project default per package.json.
# Fall back to npm/npx so the hook still works on a fresh clone before
# bun is installed.
if command -v bun >/dev/null 2>&1; then
  RUN="bun run"
else
  RUN="npm run"
fi

printf '\n→ pre-commit: typecheck (tsc --noEmit)\n'
if ! $RUN typecheck; then
  printf '\n  BLOCKED: typecheck failed.\n'
  printf '  Fix the errors above, then re-stage and commit.\n'
  printf '  In an emergency, bypass with:  git commit --no-verify\n\n'
  exit 1
fi

printf '\n→ pre-commit: lint (eslint)\n'
if ! $RUN lint; then
  printf '\n  BLOCKED: lint failed.\n'
  printf '  Fix the errors above (or run:  %s lint -- --fix), then re-stage.\n' "$RUN"
  printf '  In an emergency, bypass with:  git commit --no-verify\n\n'
  exit 1
fi

printf '\n✓ pre-commit checks passed\n\n'
exit 0
