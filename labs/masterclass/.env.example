# Stellar testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Master account — pays fees, sponsors reserves, sends initial USDC.
# Generate one with `bun run lib/generate-keypair.ts` then fund via friendbot.
MASTER_SECRET=

# Optional second account that pays the fee in blocos 1.2 and 1.4.
# If empty, MASTER pays its own fee bump (still valid demo).
SPONSOR_SECRET=

# Testnet USDC issuer (Circle's testnet issuer; verify at https://faucet.circle.com).
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Etherfuse sandbox — used in bloco 2.
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_API_KEY=

# Soroswap — used in bloco 3. Free signup at https://api.soroswap.finance/register.
# NOTE: Soroswap only indexes mainnet liquidity. Testnet quotes return empty.
SOROSWAP_BASE_URL=https://api.soroswap.finance
SOROSWAP_API_KEY=

# DeFindex — used in bloco 3. Free signup at https://api.defindex.io/register.
DEFINDEX_BASE_URL=https://api.defindex.io
DEFINDEX_API_KEY=
