#
# Prevents direct pushes to main. Use a feature branch + PR instead.
#

protected_branch="main"

while read local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -q "refs/heads/${protected_branch}$"; then
    echo ""
    echo "  BLOCKED: Direct push to '${protected_branch}' is not allowed."
    echo ""
    echo "  Use a feature branch instead:"
    echo "    git checkout -b feat/your-feature"
    echo "    git push -u origin feat/your-feature"
    echo "    gh pr create"
    echo ""
    exit 1
  fi
done

# Enforce that every non-trivial changelog/pending/*.md entry parses. This is
# the primary gate — it fires for non-Claude workflows too (e.g. Draau's shell).
# See docs/superpowers/specs/2026-07-18-agent-facing-changelog-design.md.
bun run changelog:validate || exit 1

exit 0
