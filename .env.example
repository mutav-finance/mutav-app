# Convex — auto-generated by `npx convex init`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Auth0 (Convex deployment env vars — set via `bunx convex env set`) ───────
# Convex's auth.config.ts analyzer requires these to be SET on every deployment,
# even when Auth0 isn't wired (empty string is fine and disables the provider).
# Without an explicit set, `bun dev` fails with AuthConfigMissingEnvironmentVariable.
#
# For local/preview dev (no Auth0 yet):
#   bunx convex env set AUTH0_ISSUER_BASE_URL ""
#   bunx convex env set AUTH0_CLIENT_ID ""
#
# For production (Auth0 wired):
#   bunx convex env set AUTH0_ISSUER_BASE_URL https://your-tenant.auth0.com
#   bunx convex env set AUTH0_CLIENT_ID <your-app-client-id>
