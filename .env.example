# Convex — auto-generated by `npx convex init`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Two-side config: Next.js reads cookie sessions via @auth0/nextjs-auth0;
# Convex verifies JWTs via auth.config.ts. Both halves must agree.
#
# IMPORTANT: Convex env vars MUST be SET on every deployment (dev,
# preview, prod). Convex's deploy-time analyzer scans auth.config.ts for
# referenced env vars and refuses to deploy if any are missing. Empty
# string ("") satisfies the analyzer but registers no provider — every
# wrapped handler then throws UnauthenticatedError (fail-closed). Real
# values turn the provider on.
#
# Convex side:
#   bunx convex env set AUTH0_DOMAIN your-tenant.auth0.com
#   bunx convex env set AUTH0_CLIENT_ID your-client-id

# Server-side (Next.js) — used by @auth0/nextjs-auth0 middleware + SDK.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex string. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Public app URL — used for OAuth callback construction.
APP_BASE_URL=http://localhost:3000

# Client-side (browser bundle) — Convex provider needs this to decide
# whether to wrap with ConvexProviderWithAuth or fall back to bare
# ConvexProvider. Mirrors AUTH0_DOMAIN.
NEXT_PUBLIC_AUTH0_DOMAIN=

# ─── PII crypto (LGPD P0) ────────────────────────────────────────────────────
# 32-byte base64. Generate each separately: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
